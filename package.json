{
  "name": "capitec-assessment",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@wdio/allure-reporter": "^10.0.1",
    "@wdio/appium-service": "^10.0.2",
    "@wdio/globals": "^10.0.2",
    "@wdio/local-runner": "^10.0.2",
    "@wdio/mocha-framework": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "appium-xcuitest-driver": "^12.18.0",
    "expect-webdriverio": "^8.0.0"
  },
  "scripts": {
    "wdio": "wdio run ./wdio.conf.ts",
    "wdio:mobile": "wdio run ./wdio.mobile.conf.ts",
    "wdio:api": "wdio run ./wdio.api.conf.ts",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "allure": "npm run report:generate && npm run report:open"
  },
  "dependencies": {
    "axios": "^1.20.0"
  }
}
